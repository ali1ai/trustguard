# Optional hosted LLM integration. Leave blank to disable external AI providers; local ML can still run when a trained artifact is available.
OPENAI_API_KEY=
ENABLE_LLM_PROVIDERS=false
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_AGENT_MODEL=gpt-4.1-mini
ENABLE_CONTEXT_AGENT=true
ENABLE_AUDIT_AGENT=true

# Runtime. Public-demo-safe defaults: do not persist messages or enable the reviewer API.
TRUSTGUARD_DB_PATH=./data/trustguard.db
POLICY_VERSION=2026-10-25-demo-v2
STORE_CONTENT=false
ENABLE_REVIEW_QUEUE=false
SAVE_AUDIT_EVENTS=false
# For a private reviewer deployment only: set ENABLE_REVIEW_QUEUE=true and a strong token.
REVIEW_API_TOKEN=

# Optional locally trained model artifacts (generated by the training scripts).
TRUSTGUARD_SPAM_MODEL_PATH=models/spam_classifier.joblib
TRUSTGUARD_TOXICITY_MODEL_PATH=models/toxicity_classifier.joblib
